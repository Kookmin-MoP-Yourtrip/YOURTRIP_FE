<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 상단바 (제목은 코드에서 설정) -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_common_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 진행률 바 (2/3 단계) -->
    <ProgressBar
        android:id="@+id/progressUpload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/gray_200"
        android:max="2"
        android:progress="2"
        android:progressTint="@color/blue_main"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 전체 콘텐츠 영역 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/progressUpload"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:id="@+id/block_date"
            style="@style/FormBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <!-- 안내 문구 -->
            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="업로드할 코스의 정보를 입력해 주세요."
                android:textSize="20sp"
                android:textColor="@color/gray_700"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="0dp" />

            <!-- 서브 설명 -->
            <TextView
                android:id="@+id/tvSubInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이 코스를 한줄로 설명한다면 뭐라고 할 수 있을까요?"
                android:textSize="13sp"
                android:textColor="@color/gray_550"
                android:layout_marginBottom="28dp" />

            <!-- 대표 이미지 선택 영역 -->
            <FrameLayout
                android:id="@+id/layout_image_frame"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_box_round"
                android:layout_marginBottom="10dp">

                <!-- 2-1. 추가된 사진을 보여줄 ImageView (기본적으로 숨김) -->
                <ImageView
                    android:id="@+id/ivAddedPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_box_round"
                    android:backgroundTint="@android:color/transparent"
                    android:visibility="gone" /> <!-- 처음엔 숨겨둠 -->

                <ImageView
                    android:id="@+id/btn_add_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add_image_button" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_simple_border_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <!-- 입력창 -->
                <EditText
                    android:id="@+id/et_upload_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="대전 맛도리 빵집 투어 🥖"
                    android:gravity="center"
                    android:inputType="text"
                    android:focusable="true"
                    android:paddingVertical="12dp"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />

                <!-- 오른쪽 수정 아이콘 -->
                <ImageView
                    android:id="@+id/iconEdit"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@null"
                    android:contentDescription="타이틀 입력"
                    android:src="@drawable/ic_edit"
                    tools:ignore="ContentDescription"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_upload_content"
                style="@style/RoundedEditText.Default"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="120dp"
                android:background="@drawable/bg_box_round"
                android:hint="이 코스를 사람들에게 소개해주세요."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:focusable="true"
                android:textColor="@color/gray_700"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 다음 버튼 (하단 고정) -->
    <android.widget.Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        style="@style/ChangeButtonStyle"
        android:layout_margin="30dp"
        android:text="다음"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
