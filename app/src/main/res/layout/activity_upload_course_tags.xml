<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 상단바 (제목은 코드에서 "AI 코스 만들기"로 세팅)-->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_common_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressUpload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/gray_200"
        android:max="2"
        android:progress="1"
        android:progressTint="@color/blue_main"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 전체 콘텐츠 영역 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@+id/progressUpload"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:id="@+id/block_date"
            style="@style/FormBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="5dp"
            >

            <!-- 안내 문구 -->
            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="코스와 어울리는 태그를 선택해 주세요."
                android:textSize="20sp"
                android:textColor="@color/gray_700"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="0dp" />

            <!-- 서브 설명 -->
            <TextView
                android:id="@+id/tvSubInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다른 사람들이 태그를 통해 코스를 발견할 수 있어요."
                android:textSize="13sp"
                android:textColor="@color/gray_550"
                android:layout_marginBottom="5dp" />

            <!-- 🔹 태그 선택하기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="28dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 🔹 이동 수단 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/icon_tag_movetype"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 이동 수단"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <!-- 🔹 이동 수단 태그 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tag_search_walking"
                            style="@style/Tag.Movetype"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="뚜벅이" />
                        <TextView
                            android:id="@+id/tag_search_car"
                            style="@style/Tag.Movetype"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="자차" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🔹 동행 유형 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/icon_tag_partner" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 동행 유형"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tag_search_solo"
                            style="@style/Tag.Partner"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="혼자" />

                        <TextView
                            android:id="@+id/tag_search_couple"
                            style="@style/Tag.Partner"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="연인" />

                        <TextView
                            android:id="@+id/tag_search_friends"
                            style="@style/Tag.Partner"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="친구" />

                        <TextView
                            android:id="@+id/tag_search_family"
                            style="@style/Tag.Partner"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="가족" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🔹 여행 분위기 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/icon_tag_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 여행 분위기"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tag_search_healing"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="힐링" />

                        <TextView
                            android:id="@+id/tag_search_activity"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="액티비티" />

                        <TextView
                            android:id="@+id/tag_search_food_tour"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="맛집탐방" />

                        <TextView
                            android:id="@+id/tag_search_emotional"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="감성" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tag_search_culture_exhibition"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="문화/전시" />

                        <TextView
                            android:id="@+id/tag_search_nature"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="자연" />

                        <TextView
                            android:id="@+id/tag_search_shopping"
                            style="@style/Tag.Theme"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="쇼핑" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 🔹 예산 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="3dp"
                            android:src="@drawable/icon_tag_budget" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 예산"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tag_search_budget"
                            style="@style/Tag.Budget"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="가성비" />

                        <TextView
                            android:id="@+id/tag_search_normal"
                            style="@style/Tag.Budget"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="평균예산" />

                        <TextView
                            android:id="@+id/tag_search_premium"
                            style="@style/Tag.Budget"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="프리미엄" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 다음 버튼 (하단 고정) -->
    <android.widget.Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        style="@style/ChangeButtonStyle"
        android:layout_margin="30dp"
        android:text="다음"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>