<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_box_round"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그아웃"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정말 로그아웃 하시겠습니까?"
        android:textSize="13sp"
        android:textColor="@color/gray_600"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <android.widget.Button
            android:id="@+id/btnCancelLogout"
            android:background="@drawable/bg_box_border_12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="8dp"/>

        <android.widget.Button
            android:id="@+id/btnConfirmLogout"
            android:background="@drawable/bg_box_round_12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="확인"
            android:backgroundTint="@color/blue_main"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>
