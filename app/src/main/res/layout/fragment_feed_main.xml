<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ⭐ (1) 스켈레톤 로딩 화면 -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/loadingLayout_feed_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        android:visibility="visible">

        <include layout="@layout/layout_feed_main_loading"/>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ⭐ (2) 실제 콘텐츠 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout_feed_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🔹 스크롤 안되는 영역 -->
        <LinearLayout
            android:id="@+id/topBarContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 상단 바 홈 바로가기 - 스크롤 제외 -->
                <ImageView
                    android:id="@+id/img_feed_topbar"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/actionBarSize"
                    android:src="@drawable/logo"
                    android:layout_marginStart="16dp"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- 상단 바 홈 바로가기 - 스크롤 제외 -->
                <TextView
                    android:id="@+id/tv_feed_topbar"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/actionBarSize"
                    android:gravity="center"

                    android:text="피드"
                    android:textStyle="bold"
                    android:textSize="19dp"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 검색창 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/tvFeedSearch"
                    style="@style/RoundedEditText.Default"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="장소, 테마, 코스 무엇이든 입력하세요!"
                    android:textColorHint="@color/gray_550"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"/>

                <ImageView
                    android:id="@+id/btnFeedSearch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:background="@android:color/transparent"

                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_search"
                    android:padding="8dp" />
            </RelativeLayout>
        </LinearLayout>


        <!-- 🔽 정렬 버튼 -->
        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:backgroundTint="@color/gray_150"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="정렬"
            android:textSize="14sp"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="16dp"

            app:layout_constraintTop_toBottomOf="@id/topBarContainer"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- 🔽 정렬 메뉴 -->
        <LinearLayout
            android:id="@+id/sortMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_box_round"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:layout_marginEnd="16dp"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnSort"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/sortLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최신순"
                android:textSize="14sp"
                android:textColor="@color/gray_700"
                android:paddingVertical="6dp"/>

            <TextView
                android:id="@+id/sortPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="인기순"
                android:textSize="14sp"
                android:textColor="@color/gray_700"
                android:paddingVertical="6dp"/>
        </LinearLayout>



        <!-- 피드 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_feed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/btnSort"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- 플로팅 버튼 (+) -->

        <ImageView
            android:id="@+id/btn_add_feed"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:src="@drawable/fab_add_course"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp"

            android:clickable="true"
            android:focusable="true"

            app:layout_constraintBottom_toTopOf="@+id/systemBarDummy"
            app:layout_constraintEnd_toEndOf="parent"

            android:visibility="visible"/>

        <!-- ✅ 미리보기 전용 하단 네비 바 크기 확보 (실행 시 무시됨) -->
        <View
            android:id="@+id/systemBarDummy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            tools:layout_height="62dp"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>