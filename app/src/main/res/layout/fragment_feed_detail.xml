<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ▣ (1) 스켈레톤 로딩 화면 -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/loadingLayout_feed_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        android:visibility="visible">

        <include layout="@layout/layout_feed_detail_loading"/>

    </com.facebook.shimmer.ShimmerFrameLayout>


    <!-- ▣ (2) 실제 콘텐츠 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout_feed_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">


        <!-- ▣ 상단바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/white"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="피드 자세히 보기"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/gray_700"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 🔥 더보기 버튼 (topBar 바깥으로 이동해야 정상 동작함) -->
        <ImageView
            android:id="@+id/feed_detail_btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_three_dots"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="@id/topBar"
            app:layout_constraintEnd_toEndOf="parent"/>
        <!-- ▣ 더보기 메뉴 (기본 숨김) -->
        <LinearLayout
            android:id="@+id/feed_more_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"

            android:background="@drawable/bg_box_round"
            android:elevation="8dp"
            android:paddingHorizontal="26dp"
            android:paddingVertical="10dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feed_detail_btn_more"
            android:layout_marginEnd="12dp">

            <!-- 수정하기 -->
            <LinearLayout
                android:id="@+id/btn_feed_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_edit"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="수정하기"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"/>
            </LinearLayout>

            <!-- 삭제하기 -->
            <LinearLayout
                android:id="@+id/btn_feed_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="삭제하기"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ▣ 전체스크롤 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ▣ 사진들 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_photos"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:layout_marginHorizontal="16dp"
                    android:overScrollMode="never"/>

                <!-- ▣ 프로필 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/img_profile"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_default_profile"
                        android:background="@drawable/bg_circle"
                        android:clipToOutline="true"/>

                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="사용자닉네임"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/gray_700"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/btn_like"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_heart_default"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:id="@+id/btn_chat"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chat" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 캡션 -->
                <TextView
                    android:id="@+id/tv_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_box_round"
                    android:backgroundTint="@color/gray_100"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"

                    android:text="여기에 피드 내용이 들어옵니다"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />

                <!-- ▣ 장소 -->
                <LinearLayout
                    android:layout_margin="16dp"
                    android:id="@+id/tag_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_tag"
                    android:backgroundTint="@color/tag_skyblue"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="1dp"
                        android:src="@drawable/ic_location"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:text="지역명"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 🔼🔼🔼 여기까지 기존 내용 그대로 옮겨옴 🔼🔼🔼 -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
