<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. 실제 콘텐츠(맨 처음에는 숨기기) -->
    <ScrollView
        android:id="@+id/contentLayout_mypage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <!-- 상단 제목 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="마이페이지"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- 프로필 이미지 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_circle"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@null"/>
            </FrameLayout>

            <!-- 닉네임 -->
            <TextView
                android:id="@+id/tvNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gray_700"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

            <!-- 프로필 수정 버튼 -->
            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="프로필 편집"
                android:textSize="14sp"
                android:textColor="@color/gray_700"
                android:background="@drawable/bg_profile"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- 카드 2개 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/btnMyCourse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_card_mypage"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_mycourse"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="나의 코스 보기"
                        android:textColor="@color/gray_700"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMyFeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_card_mypage"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_myfeed"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="나의 피드 보기"
                        android:textColor="@color/gray_700"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 2. 스켈레톤(최상단에 오버레이 되게 하기) -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/loadingLayout_mypage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        android:visibility="visible">

        <include layout="@layout/layout_mypage_loading"/>
    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>