<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:alpha">0</item>
    </style>

    <!-- 공통 둥근 틀 -->
    <style name="BaseRoundedBox" >
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>

        <item name="android:background">@drawable/bg_box_round</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:backgroundTintMode">src_over</item>

        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 회색(gray150) 버튼 용-->
    <style name="RoundedButton.gray" parent="BaseRoundedBox">
        <item name="android:background">@drawable/bg_btn_gray150</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- ▶️ 단색 활성화 버튼 용-->
    <style name="ChangeButtonStyle" parent="BaseRoundedBox">
        <item name="android:background">@drawable/bg_btn_change</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- ▶️ 그라데이션 활성화 버튼 용-->
    <style name="GradationChangeButtonStyle" parent="BaseRoundedBox">
        <item name="android:background">@drawable/bg_btn_gradation_change</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 🔲 1. 파란색 테두리 버튼 용 -->
    <style name="RoundedButton.OutlineBlue" parent="BaseRoundedBox">
        <item name="android:background">@drawable/bg_box_border</item>
        <item name="android:textColor">@color/blue_main</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 🔲 2. 파란색 테두리 텍스트용 -->
    <style name="RoundedTextBox.OutlineBlue" parent="BaseRoundedBox">
        <item name="android:background">@drawable/bg_box_border</item>
        <item name="android:textColor">#26282B</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>


    <!-- ✅ 1. 입력 전 텍스트 박스 (hint 보임, 연한 회색 배경) -->
    <style name="RoundedEditText.Default" parent="BaseRoundedBox">
        <item name="android:backgroundTint">@color/gray_150</item>
        <item name="android:textColorHint">@color/gray_550</item> <!-- 연한 회색 -->
        <item name="android:textColor">@color/gray_700</item>
        <item name="android:paddingStart">16dp</item> <!-- ✅ 여백 추가 -->
        <item name="android:paddingEnd">16dp</item>
    </style>


    <!-- ✅ 2. 입력 된 텍스트 박스 (텍스트만 있고, 배경 동일 or 약간 강조) -->
    <style name="RoundedEditText.Filled" parent="BaseRoundedBox">
        <item name="android:backgroundTint">@color/gray_150</item>
        <item name="android:textColorHint">@color/gray_550</item> <!-- 연한 회색 -->
        <item name="android:textColor">@color/gray_700</item>
        <item name="android:paddingStart">16dp</item> <!-- ✅ 여백 추가 -->
        <item name="android:paddingEnd">16dp</item>
    </style>


    <!-- 태그 -->
    <style name="Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>

        <item name="android:textColor">@color/gray_700</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="Tag.Movetype" parent="Tag">
        <item name="android:background">@drawable/bg_tag_movetype_selector</item>
    </style>

    <style name="Tag.Partner" parent="Tag">
        <item name="android:background">@drawable/bg_tag_partner_selector</item>
    </style>

    <style name="Tag.Theme" parent="Tag">
        <item name="android:background">@drawable/bg_tag_theme_selector</item>
    </style>


    <style name="Tag.Period" parent="Tag">
        <item name="android:background">@drawable/bg_tag_period_selector</item>
    </style>

    <style name="Tag.Budget" parent="Tag">
        <item name="android:background">@drawable/bg_tag_budget_selector</item>
    </style>

    <!-- 홈 한정 테마 태그 -->
    <style name="Tag.Home" parent="Tag">
        <item name="android:background">@drawable/bg_tag_theme_home_selector</item>
    </style>

<!--    margin 공통-->
    <style name="FormBlock">
        <item name="android:layout_marginTop">24dp</item>
    </style>

<!--    팝업창 반투명 배경 빼기-->
    <style name="TransparentDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">80%p</item>
        <item name="android:windowMinWidthMinor">80%p</item>
    </style>

    <!-- MaterialTimePicker를 위한 커스텀 테마 -->
    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <!-- 확인/취소 버튼 및 활성화된 텍스트 필드 테두리 색상 -->
        <item name="colorPrimary">@color/blue_main</item>
        <!-- AM/PM 선택 배경 등 일부 UI 요소 색상 -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- 다이얼로그의 전체적인 배경색 -->
        <item name="colorSurface">@color/white</item>
        <!-- 제목, 비활성 텍스트 등 기본 텍스트 색상 -->
        <item name="colorOnSurface">@color/black</item>
    </style>


</resources>
